<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:Template name="RegisterListElement" src="project://database/Assets/UI/UI%20Docs/Resources/RegisterListElement.uxml?fileID=9197481963319205126&amp;guid=eb284e2cb06b8bf4d90bed5d81d8fb10&amp;type=3#RegisterListElement"/>
    <Style src="project://database/Assets/UI/PatPatStyle.uss?fileID=7433441132597879392&amp;guid=f5985b321d282874f97bacc2e9998abc&amp;type=3#PatPatStyle"/>
    <Style src="project://database/Assets/UI/Pre-madeElementsStyles.uss?fileID=7433441132597879392&amp;guid=05a60a23150ba5f45b4e854efe011372&amp;type=3#Pre-madeElementsStyles"/>
    <Style src="project://database/Assets/UI/AnimalStatsStyle.uss?fileID=7433441132597879392&amp;guid=8bea74b8a86521441afc27035a0350a9&amp;type=3#AnimalStatsStyle"/>
    <ui:VisualElement name="RegisterContainer" class="PanelBackground" style="flex-grow: 0; flex-direction: column; display: flex; background-image: url(&quot;project://database/Assets/UI/Resources/Textures/GradientDownwards.png?fileID=2800000&amp;guid=50759faa553ddcc449dad8d8cc170baf&amp;type=3#GradientDownwards&quot;); width: 670px; height: 470px;">
        <ui:VisualElement name="Header" class="HeaderStyle" style="flex-direction: row;">
            <ui:VisualElement style="flex-grow: 0; width: 245px; right: auto; left: 0; top: 0; position: absolute; bottom: 0; background-color: rgb(242, 241, 239); border-top-left-radius: 20px; border-top-right-radius: 20px; border-bottom-right-radius: 20px; border-bottom-left-radius: 20px; margin-top: 10px; margin-right: 10px; margin-bottom: 10px; margin-left: 10px; flex-direction: row; padding-top: 5px; padding-right: 0; padding-bottom: 5px; padding-left: 7px; align-items: center;">
                <ui:VisualElement style="flex-grow: 0; width: 30px; height: 30px; background-image: url(&quot;project://database/Assets/UI/Resources/Textures/Coin.svg?fileID=6192944022281365145&amp;guid=066fe45bb7c5eef40a23f06b579657f3&amp;type=3#Coin&quot;);"/>
                <ui:Label text="Likes" name="MoneyAmount" style="font-size: 20px; -unity-font-definition: url(&quot;project://database/Assets/UI/Fonts/Livvic/Livvic-Bold.ttf?fileID=12800000&amp;guid=a408a2f38d08b2a429d13a1db7e7460e&amp;type=3#Livvic-Bold&quot;); -unity-text-align: middle-left; width: auto; flex-grow: 1; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 5px; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0;"/>
            </ui:VisualElement>
            <ui:Label text="Register" name="HeaderLabel"/>
        </ui:VisualElement>
        <ui:VisualElement name="VisualElement" style="flex-grow: 1; flex-shrink: 1; flex-direction: row;">
            <ui:VisualElement name="Chest" style="flex-grow: 1; width: initial; align-items: center; justify-content: flex-end; padding-top: 10px; padding-bottom: 10px;">
                <ui:Button text="" name="UpgradeButton" class="ShopButton" style="height: 65px; width: 125px; flex-direction: column; align-items: center; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; justify-content: center; min-width: 110px; max-width: 150px; padding-top: 4px; padding-bottom: 4px;">
                    <ui:Label text="Upgrade" style="margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0;"/>
                    <ui:VisualElement style="flex-grow: 1; flex-direction: row; align-items: center;">
                        <ui:Image source="project://database/Assets/UI/Resources/Textures/Coin.svg?fileID=6192944022281365145&amp;guid=066fe45bb7c5eef40a23f06b579657f3&amp;type=3#Coin" style="height: 20px; width: 20px; flex-shrink: 0;"/>
                        <ui:Label text="price" name="UpgradePriceLabel" style="margin-top: 2px; margin-right: 2px; padding-top: 2px; padding-right: 2px; padding-bottom: 2px; padding-left: 2px; -unity-font-definition: url(&quot;project://database/Assets/UI/Fonts/Livvic/Livvic-Medium.ttf?fileID=12800000&amp;guid=c17b6ee01c40d454e83c8c402f195778&amp;type=3#Livvic-Medium&quot;); font-size: 18px;"/>
                    </ui:VisualElement>
                </ui:Button>
                <ui:Image source="project://database/Assets/UI/Resources/Textures/Food/3MealIcon.png?fileID=2800000&amp;guid=7c68fa34845cca540a4a5da322f3077e&amp;type=3#3MealIcon" style="width: 82px; aspect-ratio: 1; height: 82px; margin-top: 10px; margin-bottom: 10px;"/>
                <ui:Button text="" name="BuyButton" class="ShopButton" style="flex-direction: row; align-items: center; justify-content: center; width: 125px;">
                    <ui:Image source="project://database/Assets/UI/Resources/Textures/Coin.svg?fileID=6192944022281365145&amp;guid=066fe45bb7c5eef40a23f06b579657f3&amp;type=3#Coin" style="height: 20px; width: 20px; flex-shrink: 0;"/>
                    <ui:Label text="price" name="BuyPriceLabel" style="margin-top: 2px; margin-right: 2px; padding-top: 2px; padding-right: 2px; padding-bottom: 2px; padding-left: 2px; -unity-font-definition: url(&quot;project://database/Assets/UI/Fonts/Livvic/Livvic-Medium.ttf?fileID=12800000&amp;guid=c17b6ee01c40d454e83c8c402f195778&amp;type=3#Livvic-Medium&quot;); font-size: 18px;"/>
                </ui:Button>
                <ui:Label text="Rarity chances" style="-unity-font-definition: url(&quot;project://database/Assets/UI/Fonts/Poetsen_One/PoetsenOne-Regular.ttf?fileID=12800000&amp;guid=00652dc61b80089488704a3e650887b7&amp;type=3#PoetsenOne-Regular&quot;); font-size: 18px;"/>
                <ui:VisualElement style="flex-grow: 0; flex-direction: row; width: 100%; padding-right: 10px; padding-left: 10px; justify-content: center;">
                    <ui:VisualElement style="flex-grow: 0; -unity-font-definition: url(&quot;project://database/Assets/UI/Fonts/Livvic/Livvic-SemiBold.ttf?fileID=12800000&amp;guid=6bbaee6b38702c3458ef4774312cb6b0&amp;type=3#Livvic-SemiBold&quot;); justify-content: space-around; width: 106px;">
                        <ui:Label text="Common " style="padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0;"/>
                        <ui:Label text="Uncommon" style="padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0;"/>
                        <ui:Label text="Rare " style="padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0;"/>
                        <ui:Label text="Epic " style="padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0;"/>
                        <ui:Label text="Legendary " style="padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0;"/>
                    </ui:VisualElement>
                    <ui:VisualElement style="flex-grow: 0; -unity-font-definition: url(&quot;project://database/Assets/UI/Fonts/Livvic/Livvic-SemiBold.ttf?fileID=12800000&amp;guid=6bbaee6b38702c3458ef4774312cb6b0&amp;type=3#Livvic-SemiBold&quot;); justify-content: space-around; align-items: flex-end;">
                        <ui:Label text="20% " name="CommonChance" style="padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0;"/>
                        <ui:Label text="20% " name="UncommonChance" style="padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0;"/>
                        <ui:Label text="20%" name="RareChance" style="padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0;"/>
                        <ui:Label text="20%" name="EpicChance" style="padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0;"/>
                        <ui:Label text="20%" name="LegendaryChance" style="padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0;"/>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="Line" style="flex-grow: 0; background-color: rgb(255, 255, 255); width: 3px; flex-direction: column-reverse; margin-bottom: 13px;">
                <ui:VisualElement style="flex-grow: 0; width: 24px; height: 14px; align-self: center; background-image: url(&quot;project://database/Assets/UI/Resources/Textures/Curve.svg?fileID=6192944022281365145&amp;guid=62c39823787588e4c8e497e7f5b2e4e0&amp;type=3#Curve&quot;); -unity-background-scale-mode: scale-to-fit; margin-bottom: -13px; -unity-background-image-tint-color: rgb(255, 255, 255); margin-right: 1px;"/>
            </ui:VisualElement>
            <ui:VisualElement style="width: 475px;">
                <ui:ScrollView horizontal-scroller-visibility="Hidden" style="width: 475px; flex-shrink: 1; flex-grow: 0;">
                    <ui:VisualElement name="ListContainer" style="flex-grow: 1; flex-shrink: 1; padding-top: 5px; padding-right: 0; padding-bottom: 5px; padding-left: 5px; flex-direction: row; flex-wrap: wrap; justify-content: flex-start; align-content: flex-start; visibility: visible; display: flex;">
                        <ui:Instance template="RegisterListElement" name="RegisterListElement"/>
                    </ui:VisualElement>
                </ui:ScrollView>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
