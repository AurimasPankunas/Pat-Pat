    <ui:VisualElement name="AnimalStatsContainer" style="flex-grow: 1; background-color: rgb(221, 217, 210); border-top-left-radius: 60px; border-top-right-radius: 60px; border-bottom-right-radius: 60px; border-bottom-left-radius: 60px; padding-top: 44px; padding-right: 44px; padding-bottom: 44px; padding-left: 44px;">
