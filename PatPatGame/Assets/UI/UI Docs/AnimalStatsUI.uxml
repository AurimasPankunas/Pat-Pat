<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/AnimalStatsStyle.uss?fileID=7433441132597879392&amp;guid=8bea74b8a86521441afc27035a0350a9&amp;type=3#AnimalStatsStyle"/>
    <Style src="project://database/Assets/UI/PatPatStyle.uss?fileID=7433441132597879392&amp;guid=f5985b321d282874f97bacc2e9998abc&amp;type=3#PatPatStyle"/>
    <ui:VisualElement name="AnimalStatsContainer" style="flex-grow: 1; background-color: rgb(221, 217, 210); border-top-left-radius: 60px; border-top-right-radius: 60px; border-bottom-right-radius: 60px; border-bottom-left-radius: 60px; padding-top: 44px; padding-right: 44px; padding-bottom: 44px; padding-left: 44px; justify-content: space-around;">
        <ui:Button text="" name="SpotBuyButton" class="ShopButton" style="height: 424px; flex-direction: column; align-items: center; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; min-width: 600px; padding-top: 38px; padding-bottom: 38px; align-self: center; display: none; border-top-width: 5px; border-right-width: 5px; border-bottom-width: 5px; border-left-width: 5px; border-top-left-radius: 40px; border-top-right-radius: 40px; border-bottom-right-radius: 40px; border-bottom-left-radius: 40px; font-size: 90px; justify-content: center; max-width: 900px; padding-right: 38px; padding-left: 38px;">
            <ui:Label text="Spot" name="ButtonLabel" style="margin-top: 0; margin-right: 0; margin-bottom: 74px; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0;"/>
            <ui:VisualElement style="flex-grow: 0; flex-direction: row; align-items: center;">
                <ui:Image source="project://database/Assets/UI/Resources/Textures/Coin.svg?fileID=6192944022281365145&amp;guid=066fe45bb7c5eef40a23f06b579657f3&amp;type=3#Coin" style="height: 90px; width: 90px; flex-shrink: 0; aspect-ratio: 1;"/>
                <ui:Label text="test price 50" name="SpotPriceLabel" style="margin-top: 2px; margin-right: 2px; padding-top: 2px; padding-right: 2px; padding-bottom: 2px; padding-left: 22px; -unity-font-definition: url(&quot;project://database/Assets/UI/Fonts/Livvic/Livvic-Medium.ttf?fileID=12800000&amp;guid=c17b6ee01c40d454e83c8c402f195778&amp;type=3#Livvic-Medium&quot;);"/>
            </ui:VisualElement>
        </ui:Button>
        <ui:VisualElement name="SpotEmptyContainer" style="flex-grow: 1; align-self: center; align-items: stretch; justify-content: flex-start; display: none;">
            <ui:VisualElement style="background-image: resource(&quot;Textures/EmptySpot&quot;); width: 596px; height: 542px; -unity-background-scale-mode: scale-to-fit; margin-top: 25px; margin-right: 25px; margin-bottom: 25px; margin-left: 25px;"/>
            <ui:Label text="It&apos;s lonely in here :c" style="-unity-font-definition: url(&quot;project://database/Assets/UI/Fonts/Livvic/Livvic-Bold.ttf?fileID=12800000&amp;guid=a408a2f38d08b2a429d13a1db7e7460e&amp;type=3#Livvic-Bold&quot;); font-size: 50px; -unity-text-align: upper-center;"/>
        </ui:VisualElement>
        <ui:VisualElement name="StatsContainer" style="flex-grow: 1; align-self: center; align-items: stretch; justify-content: flex-start;">
            <ui:Label text="Animal Kitty Bitty" name="NameLabel" style="-unity-text-align: middle-center; -unity-font-definition: url(&quot;project://database/Assets/UI/Fonts/Livvic/Livvic-Bold.ttf?fileID=12800000&amp;guid=a408a2f38d08b2a429d13a1db7e7460e&amp;type=3#Livvic-Bold&quot;); font-size: 66px; padding-top: 52px;"/>
            <ui:VisualElement name="BondContainer" style="width: 177px; height: 159px; align-items: center; position: absolute; top: 357px; left: 26px; -unity-background-image-tint-color: rgb(0, 0, 0); background-image: resource(&quot;Textures/HeartInside&quot;);">
                <ui:ProgressBar value="3.37" title="" name="BondBar" high-value="4" style="width: 86%; height: 112%; rotate: -90deg; margin-top: -10px; margin-right: 0; margin-bottom: 0; margin-left: 0;"/>
                <ui:VisualElement name="HeartOutline" style="flex-grow: 1; background-color: rgba(0, 0, 0, 0); flex-direction: column; display: flex; visibility: visible; position: absolute; top: 0; width: 100%; height: 100%; -unity-background-image-tint-color: rgb(221, 217, 210); background-image: resource(&quot;Textures/HeartOutlineWithBG&quot;);"/>
            </ui:VisualElement>
            <ui:VisualElement name="HappyBarContainer" style="flex-grow: 0; flex-direction: row-reverse; align-items: center; align-content: flex-start; justify-content: center;">
                <ui:ProgressBar value="1" title="" name="HappyBar" high-value="1" class="happy" style="height: 93px; width: 861px; border-left-color: rgb(0, 0, 0); border-right-color: rgb(0, 0, 0); border-top-color: rgb(0, 0, 0); border-bottom-color: rgb(0, 0, 0); border-top-left-radius: 46px; border-top-right-radius: 46px; border-bottom-right-radius: 46px; border-bottom-left-radius: 46px; margin-left: -54px; margin-top: 0; margin-right: 0; margin-bottom: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0;">
                    <ui:VisualElement name="BarCover" style="height: 100%; width: 100%; position: absolute; background-image: resource(&quot;Textures/StatsBorder&quot;); -unity-slice-scale: 0.16px; -unity-background-image-tint-color: rgb(225, 196, 82); margin-left: 1px;"/>
                </ui:ProgressBar>
                <ui:VisualElement name="HappyImage" style="-unity-background-scale-mode: scale-to-fit; width: 137px; height: 142px; background-image: resource(&quot;Textures/Happy&quot;);"/>
            </ui:VisualElement>
            <ui:VisualElement name="WaterBarContainer" style="flex-grow: 0; flex-direction: row-reverse; align-items: center;">
                <ui:ProgressBar value="1" title="" name="WaterBar" high-value="1" class="water" style="height: 80px; width: 650px; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; border-left-color: rgb(0, 0, 0); border-right-color: rgb(0, 0, 0); border-top-color: rgb(0, 0, 0); border-bottom-color: rgb(0, 0, 0); border-top-left-radius: 46px; border-top-right-radius: 46px; border-bottom-right-radius: 46px; border-bottom-left-radius: 46px; margin-left: -70px; margin-top: 36px;">
                    <ui:VisualElement name="BarCover" style="height: 100%; width: 100%; position: absolute; background-image: resource(&quot;Textures/StatsBorder&quot;); -unity-slice-scale: 0.16px; -unity-background-image-tint-color: rgb(47, 166, 209);"/>
                </ui:ProgressBar>
                <ui:VisualElement name="WaterImage" style="-unity-background-scale-mode: scale-to-fit; width: 137px; height: 142px; background-image: resource(&quot;Textures/Water&quot;);"/>
            </ui:VisualElement>
            <ui:VisualElement name="FoodBarContainer" style="flex-grow: 0; flex-direction: row-reverse; align-items: center;">
                <ui:ProgressBar value="1" title="" name="FoodBar" high-value="1" style="height: 80px; width: 650px; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; border-left-color: rgb(0, 0, 0); border-right-color: rgb(0, 0, 0); border-top-color: rgb(0, 0, 0); border-bottom-color: rgb(0, 0, 0); border-top-left-radius: 46px; border-top-right-radius: 46px; border-bottom-right-radius: 46px; border-bottom-left-radius: 46px; margin-left: -55px; margin-bottom: 43px;">
                    <ui:VisualElement name="BarCover" style="height: 100%; width: 100%; position: absolute; background-image: resource(&quot;Textures/StatsBorder&quot;); -unity-slice-scale: 0.16px; -unity-background-image-tint-color: rgb(128, 80, 10);"/>
                </ui:ProgressBar>
                <ui:VisualElement name="FoodImage" style="-unity-background-scale-mode: scale-to-fit; width: 137px; height: 142px; display: flex; background-image: resource(&quot;Textures/Food&quot;);"/>
            </ui:VisualElement>
            <ui:VisualElement name="LvlContainer" style="flex-grow: 0; flex-direction: row; justify-content: center; width: 326px; background-color: rgb(255, 255, 255); border-top-left-radius: 31px; border-top-right-radius: 31px; border-bottom-right-radius: 31px; border-bottom-left-radius: 31px; margin-top: 32px; margin-right: 11px; margin-bottom: 11px; margin-left: 11px; align-self: center; height: 128px;">
                <ui:Label text="Lvl. " name="LvlLabel" style="-unity-text-align: middle-center; -unity-font-definition: url(&quot;project://database/Assets/UI/Fonts/Livvic/Livvic-Bold.ttf?fileID=12800000&amp;guid=a408a2f38d08b2a429d13a1db7e7460e&amp;type=3#Livvic-Bold&quot;); font-size: 50px; padding-top: 4px;"/>
                <ui:Label text="30" name="LvlAmount" style="-unity-text-align: middle-center; -unity-font-definition: url(&quot;project://database/Assets/UI/Fonts/Livvic/Livvic-Bold.ttf?fileID=12800000&amp;guid=a408a2f38d08b2a429d13a1db7e7460e&amp;type=3#Livvic-Bold&quot;); font-size: 50px; padding-top: 4px;"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
