                        <ui:VisualElement name="VisualElement" style="flex-grow: 1; background-color: rgba(220, 15, 15, 0); border-top-left-radius: 42px; border-top-right-radius: 42px; border-bottom-right-radius: 42px; border-bottom-left-radius: 42px; border-top-width: 5px; border-right-width: 5px; border-bottom-width: 5px; border-left-width: 5px; border-left-color: rgb(225, 196, 82); border-right-color: rgb(225, 196, 82); border-top-color: rgb(225, 196, 82); border-bottom-color: rgb(225, 196, 82); margin-left: 51px;">
