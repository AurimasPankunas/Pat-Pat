    <ui:VisualElement name="AnimalStatsContainer" style="flex-grow: 1; background-image: url(&quot;project://database/Assets/UI/Textures/GradientDownwards.png?fileID=2800000&amp;guid=50759faa553ddcc449dad8d8cc170baf&amp;type=3#GradientDownwards&quot;); background-color: rgb(221, 217, 210); -unity-background-image-tint-color: rgb(234, 230, 222); border-top-left-radius: 60px; border-top-right-radius: 60px; border-bottom-right-radius: 60px; border-bottom-left-radius: 60px; border-top-width: 12px; border-right-width: 12px; border-bottom-width: 12px; border-left-width: 12px; border-left-color: rgb(221, 217, 210); border-right-color: rgb(221, 217, 210); border-top-color: rgb(221, 217, 210); border-bottom-color: rgb(221, 217, 210);">
        <ui:Label text="Animal Kitty Bitty" name="NameLabel" style="-unity-text-align: middle-center; -unity-font-definition: url(&quot;project://database/Assets/UI/Fonts/Livvic/Livvic-Bold.ttf?fileID=12800000&amp;guid=a408a2f38d08b2a429d13a1db7e7460e&amp;type=3#Livvic-Bold&quot;); font-size: 59px; padding-top: 52px;"/>
