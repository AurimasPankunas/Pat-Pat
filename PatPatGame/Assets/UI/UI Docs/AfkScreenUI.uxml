<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/PatPatStyle.uss?fileID=7433441132597879392&amp;guid=f5985b321d282874f97bacc2e9998abc&amp;type=3#PatPatStyle"/>
    <ui:VisualElement class="PanelBackground" style="flex-grow: 0; height: 250px; width: 300px; padding-top: 15px; padding-right: 15px; padding-bottom: 14px; padding-left: 15px;">
        <ui:VisualElement class="HeaderStyle" style="flex-grow: 0; width: 300px; height: 50px; margin-top: -20px; margin-right: 0; margin-left: -20px; margin-bottom: 10px; flex-direction: row; align-items: center; padding-bottom: 0; justify-content: flex-start; padding-right: 5px; padding-left: 5px;">
            <ui:Button text="" name="QuitButton" class="ShopButton" style="height: 40px; width: 142px; flex-direction: row; align-items: center; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; justify-content: center; min-width: 110px; max-width: 200px; border-top-width: 1.5px; border-right-width: 1.5px; border-bottom-width: 1.5px; border-left-width: 1.5px;">
                <ui:Image source="project://database/Assets/UI/Resources/Textures/Quit.svg?fileID=7388822144124034973&amp;guid=605005c4cf4ccb548adb9fbd572699e5&amp;type=3#Quit" style="height: 26px; width: 27px; flex-shrink: 0;"/>
                <ui:Label text="Quit game" name="QuitLabel" style="margin-top: 2px; margin-right: 2px; padding-top: 2px; padding-right: 2px; padding-bottom: 2px; padding-left: 2px; -unity-font-definition: url(&quot;project://database/Assets/UI/Fonts/Livvic/Livvic-Medium.ttf?fileID=12800000&amp;guid=c17b6ee01c40d454e83c8c402f195778&amp;type=3#Livvic-Medium&quot;); font-size: 18px;"/>
            </ui:Button>
        </ui:VisualElement>
        <ui:VisualElement name="WelcomeBackContainer" style="flex-grow: 1; display: flex; justify-content: space-between;">
            <ui:Label text="Welcome back!" name="Label" style="-unity-font-definition: url(&quot;project://database/Assets/UI/Fonts/Poetsen_One/PoetsenOne-Regular.ttf?fileID=12800000&amp;guid=00652dc61b80089488704a3e650887b7&amp;type=3#PoetsenOne-Regular&quot;); -unity-text-align: upper-center; padding-bottom: 10px; font-size: 20px;"/>
            <ui:VisualElement style="flex-direction: row; align-items: center; padding-bottom: 5px;">
                <ui:VisualElement style="aspect-ratio: 1; width: 28px; background-image: resource(&quot;Textures/Coin&quot;); height: 28px;"/>
                <ui:Label text="606060" name="MoneyAmount" style="padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; margin-bottom: 4px; margin-left: 4px; -unity-font-definition: url(&quot;project://database/Assets/UI/Fonts/Livvic/Livvic-SemiBold.ttf?fileID=12800000&amp;guid=6bbaee6b38702c3458ef4774312cb6b0&amp;type=3#Livvic-SemiBold&quot;); font-size: 20px;"/>
            </ui:VisualElement>
            <ui:VisualElement style="flex-direction: row; align-items: center; padding-bottom: 5px;">
                <ui:VisualElement style="aspect-ratio: 1; width: 28px; background-image: resource(&quot;Textures/Clock&quot;);"/>
                <ui:Label text="606060" name="TimeAmount" style="padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; margin-bottom: 4px; margin-left: 4px; -unity-font-definition: url(&quot;project://database/Assets/UI/Fonts/Livvic/Livvic-SemiBold.ttf?fileID=12800000&amp;guid=6bbaee6b38702c3458ef4774312cb6b0&amp;type=3#Livvic-SemiBold&quot;); font-size: 20px;"/>
            </ui:VisualElement>
            <ui:Button text="Close" name="CloseButton" class="ShopButton" style="width: 185px; align-self: center;"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
