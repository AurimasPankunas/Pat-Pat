<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/PatPatStyle.uss?fileID=7433441132597879392&amp;guid=f5985b321d282874f97bacc2e9998abc&amp;type=3#PatPatStyle"/>
    <ui:VisualElement name="ShopItemElementLong" class="ElementBackground SmallElementSize" style="justify-content: space-between; align-items: center; width: 100%; flex-direction: row; padding-right: 20px; padding-left: 20px; flex-grow: 0; flex-shrink: 1; min-width: 430px;">
        <ui:Label text="Glove name :3" name="ElementLabel" style="-unity-text-align: upper-center; -unity-font-definition: url(&quot;project://database/Assets/UI/Fonts/Livvic/Livvic-SemiBold.ttf?fileID=12800000&amp;guid=6bbaee6b38702c3458ef4774312cb6b0&amp;type=3#Livvic-SemiBold&quot;); font-size: 16px; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; position: absolute; top: 10px; left: 10px;"/>
        <ui:Image source="project://database/Assets/UI/Resources/Textures/Glove.svg?fileID=6192944022281365145&amp;guid=3f222cf088844fb49a90bdc5fedecd79&amp;type=3#Glove" name="ElementImage" tint-color="rgb(58, 150, 217)" style="flex-grow: 0; width: 93px; height: 78px; margin-top: 10px;"/>
        <ui:VisualElement style="flex-grow: 0; flex-direction: row; -unity-font-definition: url(&quot;project://database/Assets/UI/Fonts/Livvic/Livvic-SemiBold.ttf?fileID=12800000&amp;guid=6bbaee6b38702c3458ef4774312cb6b0&amp;type=3#Livvic-SemiBold&quot;); width: 132px;">
            <ui:Label text="Glove level:" style="margin-right: 0; padding-right: 0;"/>
            <ui:Label text="rare" name="GloveRarity"/>
        </ui:VisualElement>
        <ui:Button text="" name="ElementBuyButton" class="ShopButton" style="height: 65px; width: auto; flex-direction: column; align-items: center; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; justify-content: center; min-width: 110px; max-width: 150px; padding-top: 4px; padding-bottom: 4px;">
            <ui:Label text="Upgrade" style="margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0;"/>
            <ui:VisualElement style="flex-grow: 1; flex-direction: row; align-items: center;">
                <ui:Image source="project://database/Assets/UI/Resources/Textures/Coin.svg?fileID=6192944022281365145&amp;guid=066fe45bb7c5eef40a23f06b579657f3&amp;type=3#Coin" style="height: 20px; width: 20px; flex-shrink: 0;"/>
                <ui:Label text="price" name="ElementPriceLabel" style="margin-top: 2px; margin-right: 2px; padding-top: 2px; padding-right: 2px; padding-bottom: 2px; padding-left: 2px; -unity-font-definition: url(&quot;project://database/Assets/UI/Fonts/Livvic/Livvic-Medium.ttf?fileID=12800000&amp;guid=c17b6ee01c40d454e83c8c402f195778&amp;type=3#Livvic-Medium&quot;); font-size: 18px;"/>
            </ui:VisualElement>
        </ui:Button>
    </ui:VisualElement>
</ui:UXML>
