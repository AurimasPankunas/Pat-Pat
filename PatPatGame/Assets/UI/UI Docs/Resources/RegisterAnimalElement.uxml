<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/PatPatStyle.uss?fileID=7433441132597879392&amp;guid=f5985b321d282874f97bacc2e9998abc&amp;type=3#PatPatStyle"/>
    <ui:VisualElement name="RegisterListElement" class="ElementBackground SmallElementSize" style="justify-content: space-between; align-items: center; flex-direction: row; padding-right: 20px; padding-left: 20px; flex-grow: 1; flex-shrink: 1; min-width: 430px; width: initial; max-width: 460px;">
        <ui:Image source="project://database/Assets/Textures/Hands/GloveTexture.png?fileID=2800000&amp;guid=2cd2689391aeb45af8830102e3db0de2&amp;type=3#GloveTexture" name="AnimalImage" style="flex-grow: 0; width: 95px; height: 95px; aspect-ratio: 1; overflow: hidden;"/>
        <ui:VisualElement style="flex-grow: 1; height: 100%; justify-content: space-between; padding-top: 4px; padding-right: 4px; padding-bottom: 4px; padding-left: 4px;">
            <ui:Label text="Animal name " name="NameLabel" style="-unity-text-align: upper-left; -unity-font-definition: url(&quot;project://database/Assets/UI/Fonts/Livvic/Livvic-Bold.ttf?fileID=12800000&amp;guid=a408a2f38d08b2a429d13a1db7e7460e&amp;type=3#Livvic-Bold&quot;); font-size: 16px; align-self: flex-start; white-space: normal; width: 190px;"/>
            <ui:VisualElement name="HappyBarContainer" class="SmallBar" style="flex-direction: row-reverse; align-items: center; align-content: flex-start; justify-content: center; flex-shrink: 1; flex-grow: 0; padding-left: 5px;">
                <ui:ProgressBar value="0.91" title="" name="SmallHappyBar" high-value="1" class="happy" style="height: 17px; width: 150px; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; margin-left: -10px;">
                    <ui:VisualElement name="BarCover" style="height: 100%; width: 100%; position: absolute; background-image: resource(&quot;Textures/StatsBorder&quot;); -unity-slice-scale: 0.03px; -unity-background-image-tint-color: rgb(225, 196, 82); top: auto; left: auto; right: auto; bottom: auto;"/>
                </ui:ProgressBar>
                <ui:VisualElement name="HappyImage" style="-unity-background-scale-mode: scale-to-fit; width: 23px; background-image: resource(&quot;Textures/Happy&quot;); aspect-ratio: 1; flex-shrink: 0;"/>
            </ui:VisualElement>
            <ui:VisualElement style="flex-grow: 0; flex-direction: row; -unity-font-definition: url(&quot;project://database/Assets/UI/Fonts/Livvic/Livvic-SemiBold.ttf?fileID=12800000&amp;guid=6bbaee6b38702c3458ef4774312cb6b0&amp;type=3#Livvic-SemiBold&quot;); justify-content: center; font-size: 18px;">
                <ui:Label text="Lvl." name="Label" style="margin-right: 0;"/>
                <ui:Label text="rare" name="AnimalLevel"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement style="height: 100%; justify-content: space-around;">
            <ui:Button text="Take in" name="TakeInButton" class="ShopButton" style="width: auto; align-items: center; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; justify-content: center; min-width: 110px; max-width: 150px;"/>
            <ui:Button text="Turn away&#10;" name="TurnAwayButton" class="ShopButton RedButton GreyButton" style="width: auto; align-items: center; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; justify-content: center; min-width: 110px; max-width: 150px;"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
