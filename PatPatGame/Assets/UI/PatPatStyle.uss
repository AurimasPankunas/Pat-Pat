.PanelBackground {
    background-image: url("project://database/Assets/UI/Resources/Textures/GradientDownwards.png?fileID=2800000&guid=50759faa553ddcc449dad8d8cc170baf&type=3#GradientDownwards");
    background-color: rgb(221, 217, 210);
    -unity-background-image-tint-color: rgb(234, 230, 222);
    border-top-width: 4px;
    border-right-width: 4px;
    border-bottom-width: 4px;
    border-left-width: 4px;
    border-left-color: rgb(221, 217, 210);
    border-right-color: rgb(221, 217, 210);
    border-top-color: rgb(221, 217, 210);
    border-bottom-color: rgb(221, 217, 210);
    border-top-left-radius: 25px;
    border-top-right-radius: 25px;
    border-bottom-right-radius: 25px;
    border-bottom-left-radius: 25px;
}

.HeaderStyle {
    width: initial;
    height: 65px;
    background-color: rgb(225, 196, 82);
    border-top-left-radius: 25px;
    border-top-right-radius: 25px;
    border-bottom-right-radius: 25px;
    border-bottom-left-radius: 25px;
    margin-top: -5px;
    margin-right: -5px;
    margin-bottom: 0;
    margin-left: -5px;
    align-items: center;
    justify-content: space-around;
    -unity-font-definition: url("project://database/Assets/UI/Fonts/Poetsen_One/PoetsenOne-Regular.ttf?fileID=12800000&guid=00652dc61b80089488704a3e650887b7&type=3#PoetsenOne-Regular");
    font-size: 24px;
    padding-bottom: 5px;
}

.ElementBackground {
    background-color: rgb(255, 255, 255);
    border-top-left-radius: 7px;
    border-top-right-radius: 7px;
    border-bottom-right-radius: 7px;
    border-bottom-left-radius: 7px;
    margin-top: 5px;
    margin-right: 5px;
    margin-bottom: 5px;
    margin-left: 5px;
    padding-top: 10px;
    padding-right: 10px;
    padding-bottom: 10px;
    padding-left: 10px;
}

.SmallElementSize {
    width: 140px;
    height: 140px;
}

.ShopButton {
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-top-left-radius: 20px;
    border-top-right-radius: 20px;
    border-bottom-right-radius: 20px;
    border-bottom-left-radius: 20px;
    border-left-color: rgb(0, 0, 0);
    border-right-color: rgb(0, 0, 0);
    border-top-color: rgb(0, 0, 0);
    border-bottom-color: rgb(0, 0, 0);
    background-color: rgb(225, 196, 82);
    font-size: 18px;
    -unity-font-definition: url("project://database/Assets/UI/Fonts/Livvic/Livvic-Medium.ttf?fileID=12800000&guid=c17b6ee01c40d454e83c8c402f195778&type=3#Livvic-Medium");
    -unity-text-align: middle-center;
}

.ShopButton:hover {
    background-color: rgb(228, 158, 56);
}

.ShopButton:active {
    background-color: rgb(188, 115, 0);
}

.GreyButton {
    background-color: rgb(182, 173, 155);
}

.GreyButton:hover {
    background-color: rgb(155, 148, 132);
}

.GreyButton:active {
    background-color: rgb(122, 116, 103);
}

.MoneySpent {
    font-size: 18px;
    -unity-font-definition: url("project://database/Assets/UI/Fonts/Livvic/Livvic-Bold.ttf?fileID=12800000&guid=a408a2f38d08b2a429d13a1db7e7460e&type=3#Livvic-Bold");
    -unity-text-align: middle-left;
    width: auto;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 5px;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    position: absolute;
    opacity: 0;
    transition-duration: 0.5s, 0s;
    transition-property: opacity, translate;
    transition-delay: 0.5s, 1s;
    bottom: -6px;
}

.MoneySpentAnimation {
    opacity: 1;
    translate: 0 -14px;
    transition-duration: 1s;
    transition-property: all;
    transition-delay: 0s;
}

.CategoryButton {
    flex-grow: 0;
    height: 65px;
    width: auto;
    flex-direction: row;
    justify-content: flex-end;
    padding-top: 10px;
    padding-right: 10px;
    padding-bottom: 10px;
    padding-left: 10px;
    align-items: center;
    -unity-font-definition: url("project://database/Assets/UI/Fonts/Poetsen_One/PoetsenOne-Regular.ttf?fileID=12800000&guid=00652dc61b80089488704a3e650887b7&type=3#PoetsenOne-Regular");
    font-size: 20px;
    -unity-text-align: middle-left;
    background-color: rgba(255, 255, 255, 0);
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
}

.CategoryButton:hover {
    background-color: rgba(255, 255, 255, 0.51);
}

.CategoryButtonSelected {
    background-color: rgb(255, 255, 255);
}

#unity-dragger {
    margin-top: -12px;
    width: 14px;
}
