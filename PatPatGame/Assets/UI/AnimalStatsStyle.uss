.unity-progress-bar__container {
    max-height: 100%;
    min-height: 42px;
    aspect-ratio: auto;
    height: 100%;
    border-top-width: 5px;
    border-right-width: 5px;
    border-bottom-width: 5px;
    border-left-width: 5px;
    border-top-left-radius: 42px;
    border-top-right-radius: 42px;
    border-bottom-right-radius: 42px;
    border-bottom-left-radius: 42px;
}

.unity-progress-bar__background {
    border-top-width: 3px;
    border-right-width: 3px;
    border-bottom-width: 3px;
    border-left-width: 3px;
    border-top-left-radius: 37px;
    border-top-right-radius: 37px;
    border-bottom-right-radius: 37px;
    border-bottom-left-radius: 37px;
    border-left-color: rgb(24, 29, 19);
    border-right-color: rgb(24, 29, 19);
    border-top-color: rgb(24, 29, 19);
    border-bottom-color: rgb(24, 29, 19);
    background-color: rgb(0, 0, 0);
    overflow: hidden;
    margin-left: 56px;
}

.unity-progress-bar__progress {
    background-color: rgb(39, 156, 44);
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    border-bottom-left-radius: 0;
}

#HappyBar {
    background-color: rgb(225, 196, 82);
    border-left-color: rgb(225, 196, 82);
    border-right-color: rgb(225, 196, 82);
    border-top-color: rgb(225, 196, 82);
    border-bottom-color: rgb(225, 196, 82);
    border-top-width: 5px;
    border-right-width: 5px;
    border-bottom-width: 5px;
    border-left-width: 5px;
    border-top-left-radius: 42px;
    border-top-right-radius: 42px;
    border-bottom-right-radius: 42px;
    border-bottom-left-radius: 42px;
}

#WaterBar {
    background-color: rgb(47, 166, 209);
}

#FoodBar {
    background-color: rgb(128, 80, 10);
}

#BondBar .unity-progress-bar__background {
    margin-left: 0;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
}

#BondBar .unity-progress-bar__progress {
    background-color: rgb(201, 42, 42);
}
